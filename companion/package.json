{
  "name": "ets2-rr-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Windows companion for the ETS2 RR Controller Android app: vJoy virtual controller, keyboard/mouse injection, SCS telemetry bridge.",
  "type": "module",
  "main": "dist/companion/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/companion/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/companion/test/companion.test.js"
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
